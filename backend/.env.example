# =============================================================================
# FUTA Bus System - Backend environment
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.
# =============================================================================

# ===== Runtime =====
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=FUTA Bus System
APP_TIMEZONE=Asia/Ho_Chi_Minh
TRUST_PROXY=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:5174
BODY_LIMIT=100kb
LOG_LEVEL=debug
LOG_PRETTY=true

# ===== MySQL 8.0 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=futa
DB_PASSWORD=futa_dev_password
DB_NAME=quan_ly_ve_xe
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_TIMEZONE=Z
DB_SSL=false

# ===== Redis / ioredis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=futa:
REDIS_TLS=false

# ===== JWT & Auth =====
JWT_ACCESS_SECRET=dev_access_secret_change_me_32_chars_minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_32_chars_minimum
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=futa-bus-system
JWT_AUDIENCE=futa-client
REFRESH_COOKIE_NAME=futa_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/api/v1/auth
BCRYPT_SALT_ROUNDS=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ===== Seat Locking & Booking =====
SEAT_LOCK_TTL_SECONDS=480
SEAT_LOCK_MAX_EXTEND_SECONDS=900
SEAT_LOCK_MIRROR_ENABLED=true
SEAT_LOCK_SWEEP_INTERVAL_SECONDS=30
PAYMENT_TIMEOUT_MINUTES=15
BOOKING_IDEMPOTENCY_TTL_SECONDS=86400
BOOKING_EXPIRY_INTERVAL_SECONDS=15
MAX_SEATS_PER_ORDER=5
TRIP_BOOKING_CLOSE_MINUTES=30

# ===== Socket.IO =====
SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000

# ===== VNPAY Sandbox =====
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_RETURN_URL=http://localhost:3000/api/v1/payments/vnpay/return
VNP_IPN_URL=http://localhost:3000/api/v1/payments/vnpay/ipn
VNP_VERSION=2.1.0
VNP_COMMAND=pay
VNP_CURR_CODE=VND
VNP_LOCALE=vn
VNP_ORDER_TYPE=other
VNP_PAYMENT_EXPIRE_MINUTES=12
PAYMENT_RESULT_REDIRECT_URL=http://localhost:5173/payment/result
MOBILE_DEEPLINK_SCHEME=futaapp

# ===== QR soát vé =====
QR_SECRET=dev_qr_secret_change_me_32_chars_minimum
QR_ISSUER=FUTA
QR_CHECKIN_OPEN_HOURS_BEFORE=24
QR_CHECKIN_CLOSE_HOURS_AFTER=2

# ===== Rate limit =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
HOLD_RATE_LIMIT_MAX=30
IPN_RATE_LIMIT_MAX=120

# ===== Bootstrap / Seed =====
ADMIN_PHONE=0900000000
ADMIN_PASSWORD=Admin@123456
SEED_DEMO_DATA=true
